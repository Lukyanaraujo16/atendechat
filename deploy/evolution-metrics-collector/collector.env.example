# /etc/evolution-metrics-collector/collector.env  (root:root 0600)
# Endpoint de ingestão do backend AtendeChat. Usar rede privada:
#   TESTE (mesma VPS): http://127.0.0.1:8080/system/evolution-metrics
#   PRODUÇÃO: IP do backend dentro do túnel WireGuard (nunca a URL pública).
COLLECTOR_INGEST_URL=http://127.0.0.1:8080/system/evolution-metrics
# Mesmo valor de EVOLUTION_METRICS_INGEST_TOKEN no backend (openssl rand -hex 32).
COLLECTOR_INGEST_TOKEN=
# Identificador desta VPS no painel (padrão: hostname).
COLLECTOR_SOURCE=
# papel=nome-do-contêiner (papéis: api, postgres, redis).
COLLECTOR_CONTAINERS=api=evolution-api,postgres=evolution-postgres,redis=evolution-redis
COLLECTOR_INTERVAL_SECONDS=60
# Amostras guardadas em memória se o backend estiver inacessível (1440 = 24h).
COLLECTOR_MAX_BUFFER=1440
COLLECTOR_DISK_PATH=/
COLLECTOR_DOCKER_ROOT=/var/lib/docker
