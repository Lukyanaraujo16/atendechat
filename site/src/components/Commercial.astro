---
import Icon from "./Icon.astro";

const columns = [
  { name: "Novo lead", color: "var(--blue)", base: [{ t: "Design de sobrancelhas", c: "Larissa P.", v: "R$ 120" }] },
  { name: "Qualificado", color: "var(--violet)", base: [{ t: "Massagem relaxante", c: "Bruno A.", v: "R$ 180" }] },
  { name: "Proposta enviada", color: "var(--amber)", base: [{ t: "Plano mensal bem-estar", c: "Diego M.", v: "R$ 890" }] },
  { name: "Ganho", color: "var(--accent)", base: [] as { t: string; c: string; v: string }[] },
];

const points = [
  { icon: "funnel", title: "Funis e etapas sob medida", text: "Vários pipelines, etapas configuráveis, campos personalizados e visualizações salvas." },
  { icon: "clock", title: "Follow-up que não se perde", text: "Lembretes, oportunidades paradas há mais de 24, 48 ou 72 horas e filtros de atenção." },
  { icon: "box", title: "Venda e estoque conectados", text: "Produtos com variações, movimentações de estoque, vendas iniciadas no atendimento e contas a receber." },
  { icon: "chart", title: "Relatórios comerciais", text: "Valor em aberto, taxa de conversão, tempo médio de fechamento e relatórios de vendas com exportação." },
] as const;
---

<section class="section commercial" aria-labelledby="commercial-title">
  <div class="shell commercial__grid">
    <div class="commercial__copy">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Gestão comercial</p>
        <h2 id="commercial-title">Do primeiro contato ao fechamento, sem trocar de sistema.</h2>
        <p>
          A conversa vira oportunidade, a oportunidade avança no funil e a venda é registrada com baixa no estoque. CRM e
          Estoque e Vendas são módulos habilitados conforme o plano.
        </p>
      </div>
      <ul class="points">
        {
          points.map((p, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <span class="points__icon">
                <Icon name={p.icon} size={18} />
              </span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="board-wrap" data-reveal>
      <div
        class="board"
        data-timeline
        data-steps="1200,1600,1600,1400,1400"
        data-hold="4200"
        role="img"
        aria-label="Demonstração com dados fictícios: a oportunidade Pacote noivos avança de Novo lead até Ganho, e a venda é registrada com atualização do estoque."
      >
        <div class="board__kpis" aria-hidden="true">
          <div>
            <small>Valor em aberto</small>
            <b><span data-at="0" data-until="4">R$ 3.590</span><span data-at="4">R$ 1.190</span></b>
          </div>
          <div>
            <small>Ganhas no mês</small>
            <b><span data-at="0" data-until="4">2</span><span data-at="4">3</span></b>
          </div>
          <div>
            <small>Conversão</small>
            <b><span data-at="0" data-until="4">40%</span><span data-at="4">50%</span></b>
          </div>
        </div>

        <div class="board__cols" aria-hidden="true">
          {
            columns.map((col, ci) => (
              <div class="col" style={`--col: ${col.color}`}>
                <p class="col__head">{col.name}</p>
                <div class="col__cards">
                  {/* card em movimento: aparece na coluna ci entre as etapas ci+1 e ci+2 */}
                  <div class="card card--hero" data-at={String(ci + 1)} data-until={ci === 3 ? undefined : String(ci + 2)}>
                    <p class="card__t">Pacote noivos</p>
                    <p class="card__c">Lucas F. · WhatsApp</p>
                    <p class="card__v">R$ 2.400</p>
                    {ci === 3 && <span class="card__won">Venda registrada</span>}
                  </div>
                  {col.base.map((card) => (
                    <div class="card">
                      <p class="card__t">{card.t}</p>
                      <p class="card__c">{card.c}</p>
                      <p class="card__v">{card.v}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <div class="board__sale" data-at="5" aria-hidden="true">
          <span class="board__sale-icon"><Icon name="check" size={16} /></span>
          <div>
            <b>Venda #1042 registrada</b>
            <small>Pix · R$ 2.400,00 · estoque atualizado</small>
          </div>
        </div>
      </div>
      <p class="board__note">Simulação com dados fictícios.</p>
    </div>
  </div>
</section>

<style>
  .commercial {
    background:
      radial-gradient(50% 60% at 85% 40%, rgb(43 212 111 / 0.06), transparent 70%),
      var(--bg);
  }

  .commercial__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }

  .commercial .section-head {
    margin-bottom: 36px;
  }

  .commercial .section-head h2 {
    font-size: clamp(2rem, 3.6vw, 2.9rem);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  .points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
  }

  .points__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    color: var(--accent);
  }

  .points h3 {
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }

  .points p {
    color: var(--text-2);
    font-size: 0.94rem;
  }

  /* ---------- board ---------- */

  .board {
    position: relative;
    padding: 18px;
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 1px solid var(--line-2);
    box-shadow: 0 50px 120px -50px rgb(0 0 0 / 0.9);
    font-size: 12.5px;
    transition: opacity 0.6s;
  }

  .board.is-resetting {
    opacity: 0.3;
  }

  .board [data-at]:not(.is-in) {
    display: none;
  }

  .board__kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 14px;
  }

  .board__kpis div {
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    display: grid;
    gap: 2px;
  }

  .board__kpis small {
    color: var(--text-2);
    font-size: 11.5px;
  }

  .board__kpis b {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .board__kpis .is-in {
    display: inline-block;
    animation: tick 0.5s var(--ease-out) both;
  }

  .board__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    min-height: 260px;
  }

  .col {
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    padding: 10px;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .col__head {
    font-weight: 600;
    font-size: 11.5px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--col);
  }

  .col__cards {
    display: grid;
    gap: 8px;
  }

  .card {
    padding: 10px;
    border-radius: 10px;
    background: var(--surface-3);
    border: 1px solid var(--line-2);
    display: grid;
    gap: 2px;
  }

  .card__t {
    font-weight: 600;
    line-height: 1.3;
  }

  .card__c {
    color: var(--text-2);
    font-size: 11.5px;
  }

  .card__v {
    margin-top: 4px;
    font-weight: 600;
    color: var(--text-2);
  }

  .card--hero {
    border-color: rgb(43 212 111 / 0.5);
    box-shadow: 0 10px 30px -10px rgb(43 212 111 / 0.35);
  }

  .card--hero.is-in {
    animation: card-in 0.6s var(--ease-out) both;
  }

  .card--hero .card__v {
    color: var(--accent);
  }

  .card__won {
    justify-self: start;
    margin-top: 6px;
    padding: 3px 7px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.35;
  }

  .board__sale {
    position: absolute;
    right: 18px;
    bottom: -22px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--surface-3);
    border: 1px solid var(--line-2);
    box-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.7);
  }

  /* reserva o espaço do aviso para evitar salto de layout no celular */
  .board .board__sale[data-at] {
    display: flex;
    visibility: hidden;
  }

  .board .board__sale.is-in {
    visibility: visible;
    animation: card-in 0.6s var(--ease-out) both;
  }

  .board__sale-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .board__sale b {
    display: block;
    font-size: 12.5px;
  }

  .board__sale small {
    color: var(--text-2);
    font-size: 11.5px;
  }

  .board__note {
    margin-top: 36px;
    font-size: 0.8rem;
    color: var(--text-3);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateX(-18px) scale(0.97);
    }
  }

  @keyframes tick {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (max-width: 1080px) {
    .commercial__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .board {
      padding: 12px;
      font-size: 13px;
    }

    .col {
      padding: 9px;
    }

    .col__head {
      font-size: 12px;
    }

    .card__c,
    .board__kpis small,
    .board__sale small {
      font-size: 12px;
    }

    .points p {
      font-size: 0.95rem;
    }

    .board__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: 0;
    }

    .board__kpis b {
      font-size: 1.05rem;
    }

    .board__sale {
      position: static;
      margin-top: 12px;
    }

    .board__note {
      margin-top: 14px;
    }
  }
</style>

<script>
  import { initTimeline } from "../scripts/timeline";

  document.querySelectorAll<HTMLElement>(".board[data-timeline]").forEach(initTimeline);
</script>
