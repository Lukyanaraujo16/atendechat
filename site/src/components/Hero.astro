---
import { site, whatsappLink, messages } from "../config/site";
import Icon from "./Icon.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true"></div>

  <div class="shell hero__copy">
    <p class="eyebrow hero__eyebrow" data-reveal>Plataforma de atendimento omnichannel</p>
    <h1 id="hero-title" data-reveal style="--reveal-delay: 80ms">
      Cada conversa no lugar certo.<br />
      <span class="hero__accent">Cada venda sob controle.</span>
    </h1>
    <p class="hero__lead" data-reveal style="--reveal-delay: 160ms">
      O StreamHub Chat reúne WhatsApp e Instagram em uma caixa de entrada compartilhada, distribui atendimentos entre setores,
      automatiza respostas com fluxos e inteligência artificial e conecta cada conversa ao seu funil comercial.
    </p>
    <div class="hero__ctas" data-reveal style="--reveal-delay: 240ms">
      <a class="btn btn--primary" href={whatsappLink(messages.plan)} target="_blank" rel="noopener">
        Montar meu plano
        <Icon name="arrow" />
      </a>
      <a class="btn btn--ghost" href={site.appUrl}>Entrar na plataforma</a>
    </div>
    <p class="hero__note" data-reveal style="--reveal-delay: 300ms">
      Planos a partir de <strong>R$ {site.startingPrice}/mês</strong>, ajustados à sua operação.
    </p>
  </div>

  <div class="shell hero__stage" data-reveal style="--reveal-delay: 360ms">
    <div
      class="console"
      data-timeline
      data-steps="900,1400,1300,900,1600,1200,1200,1500,1300,1300"
      role="img"
      aria-label="Demonstração animada com dados fictícios: uma cliente envia mensagem pelo WhatsApp, o fluxo automático apresenta opções, o atendimento é encaminhado ao setor Comercial, a atendente assume a conversa e a oportunidade avança no funil."
    >
      <div class="console__chrome" aria-hidden="true">
        <span></span><span></span><span></span>
        <p>app.streamhubchat.com.br/tickets</p>
      </div>

      <div class="console__body" aria-hidden="true">
        <!-- Caixa de entrada -->
        <aside class="inbox">
          <div class="inbox__tabs">
            <span class="inbox__tab is-active">
              Atendendo
              <b class="count"><i data-at="0" data-until="6">2</i><i data-at="6">3</i></b>
            </span>
            <span class="inbox__tab">
              Aguardando
              <b class="count count--amber"><i data-at="0" data-until="1">0</i><i data-at="1" data-until="6">1</i><i data-at="6">0</i></b>
            </span>
          </div>

          <ul class="inbox__list">
            <li class="ticket ticket--new" data-at="1">
              <span class="avatar avatar--violet">CR</span>
              <div class="ticket__main">
                <p class="ticket__name">Camila Rocha <time>agora</time></p>
                <p class="ticket__preview">
                  <span data-at="1" data-until="4">Oi! Ainda tem horário essa semana?</span>
                  <span data-at="4" data-until="7">1</span>
                  <span data-at="7">15h fica ótimo!</span>
                </p>
                <p class="ticket__chips">
                  <span class="chip chip--amber" data-at="1" data-until="6">Aguardando</span>
                  <span class="chip chip--green" data-at="6">Atendendo</span>
                  <span class="chip">WhatsApp</span>
                  <span class="chip chip--outline" data-at="5">Comercial</span>
                </p>
              </div>
            </li>
            <li class="ticket">
              <span class="avatar avatar--blue">BA</span>
              <div class="ticket__main">
                <p class="ticket__name">Bruno Alves <time>8 min</time></p>
                <p class="ticket__preview">Pode ser às 10h, obrigado!</p>
                <p class="ticket__chips"><span class="chip chip--green">Atendendo</span><span class="chip">Instagram</span></p>
              </div>
            </li>
            <li class="ticket">
              <span class="avatar avatar--amber">DM</span>
              <div class="ticket__main">
                <p class="ticket__name">Diego Martins <time>21 min</time></p>
                <p class="ticket__preview">Vou fechar em 3x no cartão.</p>
                <p class="ticket__chips"><span class="chip chip--green">Atendendo</span><span class="chip">WhatsApp</span></p>
              </div>
            </li>
            <li class="ticket ticket--muted">
              <span class="avatar">LP</span>
              <div class="ticket__main">
                <p class="ticket__name">Larissa Prado <time>1 h</time></p>
                <p class="ticket__preview">Obrigada pelo retorno!</p>
                <p class="ticket__chips"><span class="chip">Resolvido</span></p>
              </div>
            </li>
          </ul>
        </aside>

        <!-- Conversa -->
        <div class="chat">
          <header class="chat__head">
            <span class="avatar avatar--violet">CR</span>
            <div>
              <p class="chat__name">Camila Rocha</p>
              <p class="chat__meta">
                <span data-at="0" data-until="6">Aguardando atendimento · WhatsApp</span>
                <span data-at="6">Atribuído a Marina Costa · Comercial</span>
              </p>
            </div>
            <span class="chat__action" data-at="6">Resolver</span>
          </header>

          <div class="chat__stream">
            <p class="msg msg--in" data-at="1">Oi! Vi o pacote de limpeza de pele no Instagram. Ainda tem horário essa semana?</p>

            <p class="typing typing--bot" data-at="2" data-until="3"><i></i><i></i><i></i></p>
            <div class="msg msg--bot" data-at="3">
              <span class="msg__tag">Fluxo automático</span>
              Olá, Camila! Como podemos ajudar?
              <span class="options">
                <span class="option" data-at="3">1 · Agendar ou orçamento</span>
                <span class="option">2 · Dúvidas</span>
                <span class="option">3 · Falar com a equipe</span>
              </span>
            </div>

            <p class="msg msg--in msg--short" data-at="4">1</p>
            <p class="event" data-at="5"><span>Encaminhado ao setor Comercial</span></p>
            <p class="event event--green" data-at="6"><span>Marina Costa assumiu o atendimento</span></p>

            <p class="typing" data-at="6" data-until="7"><i></i><i></i><i></i></p>
            <p class="msg msg--out" data-at="7">Oi, Camila! Tenho quinta às 15h ou às 17h. Qual prefere?</p>
            <p class="msg msg--in" data-at="8">15h fica ótimo!</p>
            <p class="event" data-at="9"><span>Etiqueta adicionada: Em negociação</span></p>
          </div>

          <div class="chat__composer">
            <span>Digite uma mensagem</span>
            <i></i>
          </div>
        </div>

        <!-- Contexto comercial -->
        <aside class="context">
          <p class="context__label">Contato</p>
          <div class="context__card">
            <p class="context__title">Camila Rocha</p>
            <dl>
              <div><dt>Setor</dt><dd><span data-at="0" data-until="5">—</span><span data-at="5">Comercial</span></dd></div>
              <div><dt>Responsável</dt><dd><span data-at="0" data-until="6">—</span><span data-at="6">Marina Costa</span></dd></div>
              <div>
                <dt>Etiquetas</dt>
                <dd><span data-at="0" data-until="9">—</span><span class="chip chip--amber" data-at="9">Em negociação</span></dd>
              </div>
            </dl>
          </div>

          <p class="context__label">Oportunidade · CRM</p>
          <div class="context__card deal">
            <p class="context__title">Limpeza de pele (3 sessões)</p>
            <p class="deal__value">R$ 480,00</p>
            <ol class="stages">
              <li class="stage is-done">Novo lead</li>
              <li class="stage" data-at="5">Qualificado</li>
              <li class="stage" data-at="10">Proposta enviada</li>
              <li class="stage">Ganho</li>
            </ol>
            <div class="deal__bar"><i class="is-done"></i><i data-at="5"></i><i data-at="10"></i><i></i></div>
          </div>

          <p class="context__label">Indicadores de hoje</p>
          <div class="context__kpis">
            <div><b><span data-at="0" data-until="6">2</span><span data-at="6">3</span></b><small>em atendimento</small></div>
            <div><b>1m 40s</b><small>1ª resposta</small></div>
          </div>
        </aside>
      </div>
    </div>
    <p class="hero__caption">Simulação com dados fictícios. Recursos como CRM, Instagram e IA dependem da configuração contratada.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(72px + clamp(40px, 6vw, 84px) + env(safe-area-inset-top));
    padding-bottom: clamp(64px, 9vw, 120px);
    overflow: hidden;
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 50% 0%, rgb(43 212 111 / 0.11), transparent 70%),
      linear-gradient(to bottom, transparent 60%, var(--bg));
  }

  .hero__backdrop::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    background-position: center top;
    mask-image: radial-gradient(70% 60% at 50% 20%, #000 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 20%, #000 0%, transparent 75%);
    opacity: 0.55;
  }

  .hero__copy {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 20px;
  }

  .hero h1 {
    font-size: clamp(2.3rem, 5.3vw, 4.3rem);
    letter-spacing: -0.04em;
    line-height: 1.03;
    max-width: 22ch;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__lead {
    max-width: 64ch;
    font-size: clamp(1.03rem, 1.5vw, 1.2rem);
    color: var(--text-2);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }

  .hero__note {
    font-size: 0.9rem;
    color: var(--text-3);
  }

  .hero__note strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero__stage {
    position: relative;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .hero__caption {
    margin-top: 16px;
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-3);
  }

  /* ---------- console ---------- */

  .console {
    --c-bg: #121614;
    --c-panel: #171c1a;
    --c-line: rgb(255 255 255 / 0.07);
    position: relative;
    border-radius: var(--radius-l);
    background: var(--c-bg);
    border: 1px solid var(--line-2);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.4),
      0 40px 120px -40px rgb(0 0 0 / 0.9),
      0 0 80px -30px rgb(43 212 111 / 0.25);
    overflow: hidden;
    font-size: 13px;
    line-height: 1.45;
    transition: opacity 0.6s var(--ease-out);
  }

  .console.is-resetting {
    opacity: 0.25;
  }

  .console__chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding: 0 16px;
    border-bottom: 1px solid var(--c-line);
    background: #0f1311;
  }

  .console__chrome span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }

  .console__chrome p {
    margin: 0 auto;
    padding: 4px 14px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.04);
    color: var(--text-3);
    font-size: 12px;
    transform: translateX(-24px);
  }

  .console__body {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) 264px;
    height: 540px;
  }

  [data-at]:not(.is-in) {
    display: none;
  }

  /* inbox */
  .inbox {
    border-right: 1px solid var(--c-line);
    background: var(--c-panel);
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .inbox__tabs {
    display: flex;
    gap: 6px;
    padding: 14px;
    border-bottom: 1px solid var(--c-line);
  }

  .inbox__tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    color: var(--text-3);
    font-weight: 500;
    font-size: 12px;
  }

  .inbox__tab.is-active {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .count i {
    font-style: normal;
  }

  .count {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 11px;
  }

  .count--amber {
    background: rgb(242 179 61 / 0.18);
    color: var(--amber);
  }

  .inbox__list {
    list-style: none;
    margin: 0;
    padding: 8px;
    display: grid;
    gap: 4px;
    align-content: start;
    overflow: hidden;
  }

  .ticket {
    display: flex;
    gap: 10px;
    padding: 10px;
    border-radius: 12px;
  }

  .ticket--new.is-in {
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 2px 0 0 var(--accent);
    animation: slide-in 0.6s var(--ease-out) both;
  }

  .ticket--muted .ticket__name {
    color: var(--text-2);
  }

  .ticket__main {
    min-width: 0;
    flex: 1;
    display: grid;
    gap: 3px;
  }

  .ticket__name {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    color: var(--text);
  }

  .ticket__name time {
    font-weight: 400;
    font-size: 11px;
    color: var(--text-3);
  }

  .ticket__preview {
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ticket__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 3px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: rgb(255 255 255 / 0.06);
    color: var(--text-2);
  }

  .chip.is-in,
  .chip--green.is-in {
    animation: pop 0.45s var(--ease-out) both;
  }

  .chip--green {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .chip--amber {
    background: rgb(242 179 61 / 0.14);
    color: var(--amber);
  }

  .chip--outline {
    background: transparent;
    box-shadow: inset 0 0 0 1px rgb(90 167 255 / 0.45);
    color: var(--blue);
  }

  .avatar {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: var(--text-2);
    font-size: 11px;
    font-weight: 700;
  }

  .avatar--violet {
    background: rgb(167 139 250 / 0.14);
    color: #c4b5fd;
  }

  .avatar--blue {
    background: rgb(90 167 255 / 0.16);
    color: var(--blue);
  }

  .avatar--amber {
    background: rgb(242 179 61 / 0.16);
    color: var(--amber);
  }

  /* chat */
  .chat {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background:
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.035) 1px, transparent 0) 0 0 / 18px 18px,
      var(--c-bg);
  }

  .chat__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--c-line);
    background: rgb(18 22 20 / 0.9);
  }

  .chat__name {
    font-weight: 600;
  }

  .chat__meta {
    font-size: 12px;
    color: var(--text-3);
  }

  .chat__action {
    margin-left: auto;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 12px;
  }

  .chat__action.is-in {
    animation: pop 0.45s var(--ease-out) both;
  }

  .chat__stream {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    padding: 18px 22px;
    mask-image: linear-gradient(to bottom, transparent 0, #000 56px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 56px);
  }

  .msg {
    max-width: min(78%, 420px);
    padding: 9px 13px;
    border-radius: 14px;
    color: var(--text);
  }

  .msg.is-in,
  .event.is-in,
  .typing.is-in {
    animation: msg-in 0.5s var(--ease-out) both;
  }

  .msg--in {
    align-self: flex-start;
    background: #232a27;
    border-bottom-left-radius: 4px;
  }

  .msg--short {
    min-width: 44px;
    text-align: center;
  }

  .msg--out {
    align-self: flex-end;
    background: #12452a;
    border-bottom-right-radius: 4px;
  }

  .msg--bot {
    align-self: flex-end;
    background: #1b2b33;
    border-bottom-right-radius: 4px;
    display: grid;
    gap: 6px;
  }

  .msg__tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .options {
    display: grid;
    gap: 4px;
    margin-top: 2px;
  }

  .option {
    padding: 6px 10px;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.05);
    color: var(--text-2);
    font-size: 12px;
  }

  .option[data-at] {
    display: block;
  }

  .console[data-step="4"] .option[data-at],
  .console[data-step="5"] .option[data-at],
  .console[data-step="6"] .option[data-at],
  .console[data-step="7"] .option[data-at],
  .console[data-step="8"] .option[data-at],
  .console[data-step="9"] .option[data-at],
  .console[data-step="10"] .option[data-at] {
    background: rgb(90 167 255 / 0.18);
    color: var(--text);
    transition: background-color 0.4s;
  }

  .event {
    align-self: center;
    font-size: 11.5px;
    color: var(--text-3);
  }

  .event span {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--c-line);
    background: rgb(0 0 0 / 0.25);
  }

  .event--green span {
    color: var(--accent);
    border-color: rgb(43 212 111 / 0.3);
  }

  .typing {
    align-self: flex-end;
    display: flex;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 14px;
    background: #12452a;
  }

  .typing--bot {
    background: #1b2b33;
  }

  .typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
    animation: blink 1.1s infinite;
  }

  .typing i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .typing i:nth-child(3) {
    animation-delay: 0.3s;
  }

  .chat__composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 16px 16px;
    padding: 11px 16px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid var(--c-line);
    color: var(--text-3);
  }

  .chat__composer i {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.85;
  }

  /* contexto */
  .context {
    border-left: 1px solid var(--c-line);
    background: var(--c-panel);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 0;
    overflow: hidden;
  }

  .context__label {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-top: 6px;
  }

  .context__card {
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--c-line);
    background: rgb(255 255 255 / 0.02);
  }

  .context__title {
    font-weight: 600;
  }

  .context dl {
    margin: 8px 0 0;
    display: grid;
    gap: 6px;
  }

  .context dl div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .context dt {
    color: var(--text-3);
  }

  .context dd {
    margin: 0;
    color: var(--text);
  }

  .context dd .is-in {
    animation: fade 0.5s var(--ease-out) both;
  }

  .deal__value {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin-top: 2px;
  }

  .stages {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 5px;
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 12px;
  }

  .stage::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  .stage[data-at] {
    display: flex;
  }

  .stage.is-done,
  .stage.is-in {
    color: var(--text);
  }

  .stage.is-done::before,
  .stage.is-in::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .stage.is-in::before {
    animation: pulse 1.6s var(--ease-out) 1;
  }

  .deal__bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    margin-top: 12px;
