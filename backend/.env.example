NODE_ENV=
BACKEND_URL=http://localhost
# Origem do painel (URL exata que o browser envia no header Origin). Para HTTPS, use https://...
# Várias origens: separadas por vírgula, ou use CORS_EXTRA_ORIGINS para URLs adicionais.
FRONTEND_URL=http://localhost:3000
# CORS_EXTRA_ORIGINS=https://app.outro-dominio.com
PROXY_PORT=8080
PORT=8080

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASS=senha
DB_NAME=db_name

# Restauro de backup (psql): se o import falhar com "must be owner of extension uuid-ossp",
# o backend pode usar o superutilizador só para importar o SQL. Em instalação com install.sh,
# DB_IMPORT_USER e DB_IMPORT_PASS são preenchidos e a palavra-passe do postgres é alinhada no cluster.
#DB_IMPORT_USER=postgres
#DB_IMPORT_PASS=

JWT_SECRET=kZaOTd+YZpjRUyyuQUpigJaEMk4vcW4YOymKPZX0Ts8=
JWT_REFRESH_SECRET=dBSXqFg9TaNUEDXVp6fhMTRLBysP+j2DSqf7+raxD3A=

REDIS_URI=redis://:123456@127.0.0.1:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

# Ambiente operacional StreamHUB (obrigatório para resolvedor Efí 8.3-B1).
# Independente de NODE_ENV e hostname. Valores: test | production
STREAMHUB_RUNTIME_ENV=test

# Criptografia de credenciais Efí no banco (AES-256-GCM). Sem fallback para chaves de IA/Meta.
# Obrigatória para ler/gravar secrets via PlatformEfiConfigs (efic1:).
EFI_CREDENTIAL_ENCRYPTION_KEY=

# Cache runtime de P12 materializado (opcional). Fonte durável = blob cifrado no DB.
# EFI_CERT_RUNTIME_CACHE_DIR=

# Efí / Gerencianet — LEGADO (checkout/webhook atuais ainda usam env até 8.3-B3).
# sandbox default true (seguro). Produção: false + cert de produção.
GERENCIANET_SANDBOX=true
GERENCIANET_CLIENT_ID=Client_Id_Gerencianet
GERENCIANET_CLIENT_SECRET=Client_Secret_Gerencianet
GERENCIANET_PIX_CERT=certificado-Gerencianet
GERENCIANET_PIX_KEY=chave pix gerencianet
# Obrigatório em produção (auth do webhook PIX). Em development pode ficar vazio.
WEBHOOK_SUBSCRIPTION_SECRET=

# Financeiro SaaS — defaults seguros até homologação
SAAS_BILLING_AUTO_INVOICE=false
SAAS_BILLING_AUTO_RENEW_ON_PAYMENT=true
SAAS_BILLING_GRACE_DAYS=3
EFI_PIX_ENABLED=true
EFI_BOLETO_ENABLED=false
EFI_CARD_ENABLED=false
EFI_COBRANCAS_SETTLE_ENABLED=false
EFI_NATIVE_SUBSCRIPTION_ENABLED=false
# Credenciais API Cobranças (boleto/cartão/settle) — opcional; fallback GERENCIANET_*
#EFI_COBRANCAS_CLIENT_ID=
#EFI_COBRANCAS_CLIENT_SECRET=
#EFI_COBRANCAS_NOTIFICATION_URL=

# EMAIL
 MAIL_HOST="smtp.gmail.com"
 MAIL_USER="seu@gmail.com"
 MAIL_PASS="SuaSenha"
 MAIL_FROM="seu@gmail.com"
 MAIL_PORT="465"

CAMPAIGN_RATE_LIMIT=10000
CAMPAIGN_BATCH_SIZE=50

# Instagram Direct (Meta Graph API)
# META_APP_ID e META_APP_SECRET: credenciais do app em developers.facebook.com
# META_TOKEN_ENCRYPTION_KEY: chave dedicada para criptografar tokens (recomendado; 32+ caracteres)
# Se META_TOKEN_ENCRYPTION_KEY não estiver definida, usa META_APP_SECRET como fallback
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
# AI_PROVIDER_CREDENTIAL_ENCRYPTION_KEY: criptografia de API keys do Agente de IA (recomendado; 32+ caracteres)
# Se não definida, usa META_TOKEN_ENCRYPTION_KEY ou META_APP_SECRET como fallback
AI_PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
# OAuth Instagram Login (Fase 8)
META_OAUTH_REDIRECT_URI=https://api.streamhubchat.com.br/instagram/oauth/callback
META_INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
# META_GRAPH_API_VERSION=v21.0
# Webhook Instagram Direct (Meta)
META_WEBHOOK_VERIFY_TOKEN=
# subscribed_apps: ao conectar token, tenta messages+comments+...; fallback automático para messages

# Evolution API — provisionamento central StreamHub (Fase 10.5)
# URL base do servidor Evolution gerenciado pela plataforma (sem barra final).
EVOLUTION_CENTRAL_BASE_URL=
# API key global do servidor Evolution (nunca expor ao tenant).
EVOLUTION_CENTRAL_API_KEY=
# Criptografia das credenciais por conexão (WhatsappEvolutionCredential).
EVOLUTION_CREDENTIAL_ENCRYPTION_KEY=
# URL pública do backend para webhooks Evolution (lifecycle Fase 10).
EVOLUTION_WEBHOOK_PUBLIC_BASE_URL=
